.pytest_cache/

# Large rasters and models (external data)
data/training_features.tif*
data/labels.tif
data/existing_faults.tif
data/sample_submission.tif
data/example_submission.tif
data/artifacts/*.pkl
data/artifacts/*.npy
data/bridge/

# Keep downloads and docs
!downloads/submission.tif
!downloads/submission.zip
!downloads/submission_meta.json
!downloads/8GEMSDOE-Apex-Geothermal-V1.tif
!docs/downloads/

.venv/

# derived feature planes (recomputable, large)
data/derived/

# External aux channels: large rasters are fetched, not committed. The sha256-pinned
# bridge manifests ARE committed (they carry the checksums + upstream provenance); the
# multi-MB parts are not. `bash scripts/fetch_aux_bridge.sh` re-fetches and verifies them.
data/external/*
!data/external/dem_links.json
data/aux_bridge/*/*.part-*
data/aux_bridge/*/*_u8.tif
data/derived/
